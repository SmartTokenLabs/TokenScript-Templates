<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com"/>
<link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>


<style>
					/* <![CDATA[ */
					* {
	font-family: 'Rubik', sans-serif;
	box-sizing: border-box;
}
body {
	color: #0b0b0b;
}

h2 {
	font-size: 20px;
}

h3 {
	font-size: 18px;
}

h5 {
	font-size: 16px;
	margin-bottom: 12px;
}

p.light {
	color: #545454;
}

body > h1 {
	font-size: 22px;
}

					/* ]]> */
				</style></ts:viewContent>

		<ts:card name="friendship" origins="Token" type="token">
			<ts:label>
				<ts:string xml:lang="en">Get Friends</ts:string>
			</ts:label>
			<ts:view xmlns="http://www.w3.org/1999/xhtml" urlFragment="friendship" xml:lang="en">
				<ts:viewContent name="common"/>
			</ts:view>
		</ts:card>

		<ts:card name="messages" origins="Token" type="token">
			<ts:label>
				<ts:string xml:lang="en">Chat with Friends</ts:string>
			</ts:label>
			<ts:view xmlns="http://www.w3.org/1999/xhtml" urlFragment="messages" xml:lang="en">
				<ts:viewContent name="common"/>
			</ts:view>
		</ts:card>

		<ts:card name="Info" origins="Token" type="token">
			<ts:label>
				<ts:string xml:lang="en">Info</ts:string>
			</ts:label>
			<ts:view xmlns="http://www.w3.org/1999/xhtml" urlFragment="info" xml:lang="en">
				<ts:viewContent name="common"/>
			</ts:view>
		</ts:card>

	</ts:cards>

	<ts:attribute name="contractOwner">
		<ts:type><ts:syntax>1.3.6.1.4.1.1466.115.121.1.7</ts:syntax></ts:type>
		<ts:origins>
			<ethereum:call as="address" contract="Token" function="owner">
			</ethereum:call>
		</ts:origins>
	</ts:attribute>

	<ts:attribute name="contractName">
		<ts:type><ts:syntax>1.3.6.1.4.1.1466.115.121.1.7</ts:syntax></ts:type>
		<ts:origins>
			<ethereum:call as="utf8" contract="Token" function="name">
			</ethereum:call>
		</ts:origins>
	</ts:attribute>

	<ts:attribute name="contractURI">
		<ts:type><ts:syntax>1.3.6.1.4.1.1466.115.121.1.7</ts:syntax></ts:type>
		<ts:origins>
			<ethereum:call as="utf8" contract="Token" function="contractURI">
			</ethereum:call>
		</ts:origins>
	</ts:attribute>

</ts:token>