<ts:token xmlns:ethereum="urn:ethereum:constantinople" xmlns:ts="http://tokenscript.org/2024/01/tokenscript" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="brett" xsi:schemaLocation="http://tokenscript.org/2024/01/tokenscript https://www.tokenscript.org/schemas/2024-01/tokenscript.xsd">
	<ts:label>
		<ts:plurals xml:lang="en">
			<ts:string quantity="one">brett Token</ts:string>
			<ts:string quantity="other">brett Tokens</ts:string>
		</ts:plurals>
	</ts:label>
	<ts:meta>
		<ts:description xml:lang="en">a simple tapp enabling smart token actions</ts:description>
		<ts:aboutUrl xml:lang="en">https://www.basedbrett.com/</ts:aboutUrl>
		<ts:iconUrl xml:lang="en">https://assets.coingecko.com/coins/images/33747/large/ogbretttttttt.jpg?1703454425</ts:iconUrl>
	</ts:meta>
	<ts:contract interface="erc20" name="Token">
		<ts:address network="8453">0x4ed4E862860beD51a9570b96d89aF5E1B0Efefed</ts:address>
	</ts:contract>
	<ts:origins>
		
		<ts:ethereum contract="Token"/>
	</ts:origins>

	<ts:cards>
		<ts:viewContent xmlns="http://www.w3.org/1999/xhtml" name="common">
			
			
		
    <meta charset="UTF-8"/>
    <link rel="icon" type="image/svg+xml" href="./vite.svg"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>TokenScript + Vite + React + TS</title>
