	<ts:label>
		<ts:plurals xml:lang="en">
			<ts:string quantity="one">brett Token</ts:string>
			<ts:string quantity="other">brett Tokens</ts:string>
		</ts:plurals>
	</ts:label>
	<ts:meta>
		<ts:description xml:lang="en">a simple tapp enabling smart token actions</ts:description>
		<ts:aboutUrl xml:lang="en">https://www.basedbrett.com/</ts:aboutUrl>
	</ts:meta>
